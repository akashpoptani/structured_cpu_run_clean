# L120K8K32 -- the headline run. Lin=120000, Lout=8192, TP2, B=1, bf16.
# TPOT is the metric; prefill just has to finish in reasonable time.
#
# chunk=32768 rather than 2048. Measured per-MoE-layer (job 27930326, real
# 128-local-expert config) scaled to Lin=120k:
#     chunk= 2048 -> 59 chunks, MoE 45.0 min, each expert sees 64 tokens
#     chunk=32768 ->  4 chunks, MoE  8.4 min, each expert sees 1024 tokens
# Two compounding reasons: 654 GB of expert weights is re-streamed once PER
# CHUNK (37.9 TB vs 2.6 TB), and small-M GEMMs are starved (1.83 TFLOP/s at
# M=64 vs 10.60 at M=1024).
# Projected total: MoE 6.7 + indexer 15.1 + attention 30.1 + wo 1.1 = ~53 min,
# against 552 min measured at chunk=2048.
#
# USE_BATCHED_MOE with the token gate: sorted dispatch is 1.26-1.86x on prefill
# chunks but 0.87-0.95x on decode, and 8192 decode steps would pay that penalty
# 8192 times. FLASHMLA_MOE_MIN_TOKENS=512 keeps the plain loop for decode.
#
# mem 820G: 600 weights + ~50 transients at chunk=32768, leaving 160G+ free on
# the node so the LC_128k jobs can still share it.

EXPERIMENT_ID="PFMAX"
RUN_LABEL="PFMAX"
RUN_MODE="generate"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=96
SBATCH_MEM="700G"
SBATCH_TIME="04:00:00"

OMP_NUM_THREADS=96

LIN_TOKENS=120000
LOUT_TOKENS=8
BATCH_SIZE=1

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""

PREFILL_CHUNK=32768
USE_AMX_ATTENTION=1
FLASHMLA_DECODE=1
FLASHMLA_THREADS=32
USE_BATCHED_MOE=1
FLASHMLA_MOE_MIN_TOKENS=512

# AMX indexer: 85-95x over the torch path (27.9 vs 0.29 TFLOP/s), 100% top-2048
# set overlap on fp8 inputs. Without it the indexer alone is ~9.1 h at this Lin,
# and at chunk=32768 its [M,64,N] temp would be 1.0 TB.
USE_AMX_INDEXER=1

# EVERYTHING ON: 96 cores (was 64), chunk=32768, AMX indexer, AMX prefill+decode
# kernels, batched MoE (shared-expert ordering now fixed, gated at 512 tokens so
# decode keeps the plain loop). Lout=8 -- this run is about TTFT, TPOT is already
# measured at 4770 ms from job 27930739.
