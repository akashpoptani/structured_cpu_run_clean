# TPBFHOM: TP2 + BF16 at B=2, HOMOGENEOUS - both slots from code_debug
# Fills the missing cell in the precision x sharding matrix:
#         TP2            DP2_EPON
#  FP8    IBB2 (done)    -
#  BF16   THIS           DPB2
# Without it, BF16 batching is only demonstrated alongside DP+EP and a
# failure could not be attributed to one or the other.
# Uses the dequant cache (DEQUANT_CACHE_MODE=read), i.e. the F.linear
# branch of upstream linear(), not our fp8_gemm override.

EXPERIMENT_ID="TPBFHOM"
RUN_LABEL="TPBFHOM"
RUN_MODE="generate"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="bf16"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32

LIN_TOKENS=128
LOUT_TOKENS=2
BATCH_SIZE=2

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK="code_debug"
