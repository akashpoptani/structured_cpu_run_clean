# Baseline clean CPU configuration.
# This file is consumed by scripts/parse_config.sh for local validation only.

# -----------------------------------------------------------------------------
# 1. Experiment
# -----------------------------------------------------------------------------

EXPERIMENT_ID="BASELINE"
RUN_MODE="verify"        # verify | bench | both | generate
RUN_LABEL="BASELINE"
REAL_RUN=1               # 0 = mock/dry-run; 1 = real distributed inference (default)
NATIVE_NO_LOAD_WEIGHTS=0 # 1 = construct only; skip weight load and generation
NATIVE_NO_GENERATE=0     # 1 = load weights but skip the decode loop

# RUN_MODE values:
# - verify: run correctness check against GPU_REFERENCE_PATH.
# - bench: run timing benchmark only.
# - both: run a small verification case first, then run benchmark.
# - generate: run inference and print generated output without verification or benchmark aggregation.

# -----------------------------------------------------------------------------
# 2. Paths
# -----------------------------------------------------------------------------

PROJECT_ROOT="/home/akashpt/DeepSeekRun/structured_cpu_run_clean"
CLEAN_ROOT="/home/akashpt/DeepSeekRun/structured_cpu_run_clean"
DEEPSEEK_REPO="../DeepSeek-V3.2"
MODEL_PATH_FP8="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2"
MODEL_PATH_BF16="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-bf16/"
TOKENIZER_PATH=""
GPU_REFERENCE_PATH="verification/references/"
OUTPUT_ROOT="results_clean"
MODEL_ARGS_CONFIG_PATH="../DeepSeek-V3.2/inference/config_671B_v3.2.json"
SHARDED_CKPT_PATH=""

# TOKENIZER_PATH may remain empty for now. Later parser logic can derive it
# from MODEL_PATH_FP8 or MODEL_PATH_BF16 if needed.
# GPU_REFERENCE_PATH is where the clean lane should expect golden reference
# inputs and outputs for verification.
#
# MODEL_ARGS_CONFIG_PATH is the native DeepSeek ModelArgs JSON consumed
# directly by ../DeepSeek-V3.2/inference/model.py (the upstream pattern is
# `args = ModelArgs(**json.load(f))`). It is separate from the HF-style
# checkpoint config.json that lives under ACTIVE_MODEL_PATH. The HF-style
# config.json is not used by the clean native inference path; treat it as
# checkpoint metadata only.
#
# SHARDED_CKPT_PATH is the directory containing per-rank converted safetensor
# shards (filenames like model{rank}-mp{world_size}.safetensors), produced by
# ../DeepSeek-V3.2/inference/convert.py at checkpoint-conversion time. Empty
# in the baseline; per-experiment override files must set it for any REAL_RUN
# distributed verification. The directory should also contain the tokenizer
# (tokenizer.json + tokenizer_config.json).

# -----------------------------------------------------------------------------
# 3. Slurm resources
# -----------------------------------------------------------------------------

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=96
SBATCH_MEM="950G"
SBATCH_TIME="06:00:00"
SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

# -----------------------------------------------------------------------------
# 4. Parallelism
# -----------------------------------------------------------------------------

DP_SIZE=2
TP_SIZE=1
EP_SIZE=2
PP_SIZE=1
SHARDING_MODE="dp2_epon"

# PP_SIZE must remain 1 for now (always lol).
# Pipeline parallelism is out of scope.
# SHARDING_MODE is the current high-level mode name used by the existing CPU
# path style.

# -----------------------------------------------------------------------------
# 5. Workload / request
# -----------------------------------------------------------------------------

LIN_TOKENS=10
LOUT_TOKENS=15
BATCH_SIZE=1
SESSION_MODE=0

# BATCH_SIZE is the number of prompts processed together.
# SESSION_MODE means one allocation can run multiple cases without restarting
# everything.

# -----------------------------------------------------------------------------
# 6. Precision
# -----------------------------------------------------------------------------

WEIGHTS_PRECISION="bf16"
KV_CACHE_DTYPE="fp8"

# WEIGHTS_PRECISION and KV_CACHE_DTYPE are separate concepts.
# KV_CACHE_DTYPE sets both caches (src/overrides/mla_absorbed.py, indexer_forward.py):
#   fp8   upstream: MLA kv round-tripped through fp8 into its bf16 cache; indexer
#         k_cache real fp8 + per-key scale; indexer q act_quant'd. GPU-reference exact.
#   bf16  no act_quant anywhere: both caches hold plain bf16. Not token-exact vs
#         the GPU references. Installs both overrides even with PREFILL_CHUNK=0.

# -----------------------------------------------------------------------------
# 7. Runtime flags
# -----------------------------------------------------------------------------

OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"
SKIP_INDEXER_BROADCAST=1
PREFILL_CHUNK=0
USE_AMX_PREFILL_ATTENTION=0
AMX_PREFILL_ATTENTION_SO=""
USE_AMX_PREFILL_INDEXER=0
AMX_PREFILL_INDEXER_SO=""
PROMPT_SOURCE="synthetic"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
BF16_CKPT_INDEX=""

# DEQUANT_CACHE_MODE: optional persistence of the per-rank BF16-dequantized
# weights to scratch. Only meaningful when DEQUANT_FP8_WEIGHTS="all".
#   "off"           -> no cache action (default).
#   "write"         -> load FP8 shard, dequant, then write the BF16 cache shard.
#                      If the cache shard already exists, the write is skipped.
#   "read"          -> load the BF16 cache shard; fail if missing. Skips
#                      FP8 load and dequant entirely.
#   "read_or_write" -> if the BF16 cache shard exists, read it; otherwise
#                      fall back to the FP8+dequant path and write the cache.
# BF16_CKPT_INDEX: path to a model.safetensors.index.json for an EXTERNAL BF16
# checkpoint produced offline by scripts/convert_to_bf16.py. May contain the
# literal {RANK}, substituted per rank. When non-empty it TAKES PRECEDENCE over
# DEQUANT_CACHE_MODE: weights are already BF16, so there is no FP8 load, no
# dequant pass and no cache write, and ModelArgs.dtype is forced to "bf16".
# Empty by default.
#
# DEQUANT_CACHE_PATH: directory holding the per-rank cache files
# (model{rank}-mp{world_size}-bf16-dequant-all.safetensors plus a
# *.metadata.json sibling). Empty by default.

# OMP_NUM_THREADS: number of OpenMP threads per rank. 32 is the measured
#   optimum for TP2 decode; 96 was 4.3x worse.
# OMP_PROC_BIND: OpenMP thread binding policy. "false" (no binding) is the
#   default because "close" measured 5.5x slower on decode at 8 threads and
#   9.4x at 32. Note this value comes from here, not from the launcher: the
#   launcher's ${OMP_PROC_BIND:-...} fallback never fires, because
#   run_native_distributed.sh sources the resolved config first.
# OMP_PLACES: OpenMP placement policy. Inert while OMP_PROC_BIND="false";
#   kept for future placement experiments.
# SKIP_INDEXER_BROADCAST: suppress the Indexer's cross-rank debug broadcast
# (upstream model.py:485). It writes into a clone and the original is returned,
# so it asserts rank agreement rather than computing anything; every rank already
# derives topk_indices identically. 1 (default) removes 61 discarded collectives
# per forward. Set 0 only to A/B the token-exactness claim. Temporary: item 7
# (true DP) makes suppression mandatory, after which this field should be deleted.
# PREFILL_CHUNK: feed the prompt through the model in chunks of this many tokens.
#   0 (default) -> single-shot prefill on the upstream MHA path.
#   N > 0       -> chunks of N, on the absorbed path (src/overrides/mla_absorbed.py),
#                  which reads the kv cache so later chunks see earlier ones.
# USE_AMX_PREFILL_ATTENTION: 1 = prefill attention core runs in the AMX kernel
#   (FlashMLA_CPU/amx_prefill_attention.so; build it first with FlashMLA_CPU/build_libs.sh)
#   instead of torch. Also installs the absorbed path when PREFILL_CHUNK=0. Decode
#   is unaffected. AMX_PREFILL_ATTENTION_SO overrides the .so path (empty = default).
# USE_AMX_PREFILL_INDEXER: 1 = prefill indexer scores (fp8_index, M > 1) run in the AMX kernel
#   (FlashMLA_CPU/amx_prefill_indexer.so, also built by build_libs.sh) instead of torch.
#   Works with or without the absorbed path; mask and top-k stay in torch; decode is
#   unaffected. AMX_PREFILL_INDEXER_SO overrides the .so path (empty = default).
# PROMPT_SOURCE: where bench/generate prompts come from.
#   "synthetic"     -> repeat a pangram seed to reach LIN_TOKENS (default).
#                      Cheap and exact, but every token routes to the same few
#                      experts, so any routing or EP load number is an artifact.
#   "infinitebench" -> truncate a real long document to exactly LIN_TOKENS.
#                      Required for anything content-dependent. Fetch the corpus
#                      once from a login node: bash scripts/fetch_infinitebench.sh
# PROMPT_CORPUS_PATH: directory holding the InfiniteBench <task>.jsonl files.
#   Only read when PROMPT_SOURCE="infinitebench".
# PROMPT_SEED: selects which records are drawn. Same seed -> identical prompts.
# PROMPT_TASK: pin one domain (longbook_sum_eng | code_debug |
#   longdialogue_qa_eng | longbook_qa_eng). Empty = round-robin across all of
#   them, which is what gives a batch its cross-domain diversity.
# DEQUANT_FP8_WEIGHTS: controls FP8-to-BF16 pre-dequant behavior at load.
#   "all"  -> (default) dequantize every FP8 Linear weight to BF16 in place, so
#             every projection is a BF16 GEMM (oneDNN/AMX). TP2 token-exact baseline.
#   "none" -> keep FP8; the per-call FP32 fallback in src/overrides/kernel.py runs
#             instead (~10x slower, no AMX). Also required with BF16_CKPT_INDEX,
#             whose weights are already BF16.
# (The legacy "dense" scope is not exposed in the clean lane right now.)

# -----------------------------------------------------------------------------
# 8. Profiling
# -----------------------------------------------------------------------------

MEM_PROFILE=0
TIME_PROFILE=0
PROFILE_GRANULARITY="off"

# MEM_PROFILE enables memory breakdown when implemented.
# TIME_PROFILE enables component timing when implemented.
# PROFILE_GRANULARITY can later be off | coarse | detailed.
