# TP2K (bench): TP2 dequant=all long-context feasibility + throughput run at
# Lin=2048 / Lout=2048 on 8 cores per rank. Reads the BF16 dequant cache.
#
# Purpose
#   1. First run past the ~100-token regime. Measures whether a 2048-token
#      single-shot prefill fits in memory and how TTFT scales.
#   2. Tests the low-core-count hypothesis. TPSMALLGEN (c=16, dequant=all)
#      decoded at 10.36 s/token while TPCACHE_SMALLGEN (c=1, dequant=all,
#      same lin16/lout9 shape) decoded at 5.89 s/token — 1.76x FASTER on
#      1/16th the cores. That contradicts the TPGEN header's claim that the
#      AMX BF16 path is compute-bound and scales with cores. c=8 is the
#      probe between those two points.
#
# NOT a numerics test: max_seq_len = LIN + LOUT = 4096, and both the YaRN
# RoPE correction (model.py:394) and the mscale softmax adjustment
# (model.py:535) are gated on `> original_seq_len` where original_seq_len
# is 4096. At exactly 4096 neither fires. This run is the control; crossing
# the threshold needs LIN + LOUT >= 4097.
#
# Memory: BF16 weights are ~674 GB per rank (cache dir is 1.35 TB for two
# ranks). KV cache at 4096 tokens adds ~321 MB (78.3 KB/token). Prefill
# transients at seqlen=2048 are ~0.5 GB for the MLA score matrix
# (1 x 2048 x 64 heads x 2048, bf16) plus ~0.5 GB for the indexer logits
# (fp32 in the override). 950G leaves comfortable headroom on a 1003 GiB node.
#
# Walltime: budget = cache load (~15-30 min) + prefill (~1.5-3 h, from
# 260 s per 100 prompt tokens at c=72) + decode (2048 tokens at 10-20 s each
# = 6-11 h). 24 h requested; partition MaxTime is 14 days.

EXPERIMENT_ID="TP2K"
RUN_LABEL="TP2K"
RUN_MODE="bench"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="04:00:00"

OMP_NUM_THREADS=32

LIN_TOKENS=2048
LOUT_TOKENS=2048
BATCH_SIZE=1
OMP_PROC_BIND="false"
OMP_PLACES="cores"
