# BCASTCHK: token-exact TP2 verification with SKIP_INDEXER_BROADCAST=1.
# Gate for plan item 3 -- proves suppressing the Indexer's debug broadcast
# (upstream model.py:485) leaves generated tokens unchanged vs
# verification/references/prompt1_bs1_lin10_lout15/case_0001.json.
#
# Resources sized from need, not from a previous config:
#   FP8 weight shard  = 314.8 GiB/rank (DEQUANT_FP8_WEIGHTS="none", no BF16 anywhere)
#   KV cache          = 25 tokens x 78.3 KB ~= 2 MB
#   -> 400 GiB/rank is ~85 GiB of headroom over the weights; 500 GiB was dead space.
# Partition ramanvr: fits lh0913 (idle) + lh0900 (18 cores, ~423 GiB free) as of
# 2026-10-06. project_l could not schedule 500 GiB -- lh1800 had only ~373 GiB free.

EXPERIMENT_ID="BCASTCHK"
RUN_LABEL="BCASTCHK"
RUN_MODE="verify"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="none"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=16
SBATCH_MEM="400G"
SBATCH_TIME="01:00:00"

OMP_NUM_THREADS=16
