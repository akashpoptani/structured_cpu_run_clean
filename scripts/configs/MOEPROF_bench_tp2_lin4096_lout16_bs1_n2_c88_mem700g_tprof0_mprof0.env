# MoE profile: split the invisible 61% of a decode step.
#
# Job 27933571 measured, decode-only at BS=1/ctx=4096 (TPOT 1980 ms):
#     out_proj 363 | indexer 208 | qkv_proj 121 | absorb_q 42 | attention 41
#     SUM 776 -> the other ~1204 ms (61%) is MoE/MLP and was not instrumented.
# moe_batched.py now ticks moe_gate / moe_experts / moe_shared / moe_allreduce
# into the same STAGE_MS dict, so this run attributes that 1204 ms.
#
# Deliberately tiny: BS=1 only, Lout=16. One cell, ~30 min including the
# first-touch prefill, against hours for the full batch sweep.

EXPERIMENT_ID="MOEPROF"
RUN_LABEL="MOEPROF"
RUN_MODE="bench"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=88
SBATCH_MEM="700G"
SBATCH_TIME="01:30:00"

OMP_NUM_THREADS=88

LIN_TOKENS=4096
LOUT_TOKENS=16
BATCH_SIZE=1
BS_SWEEP="1"
SYNTH_CTX=4096
SYNTH_PREFILL=1024

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""

PREFILL_CHUNK=1024
USE_AMX_ATTENTION=1
FLASHMLA_DECODE=1
FLASHMLA_THREADS=32
USE_BATCHED_MOE=1
FLASHMLA_MOE_MIN_TOKENS=512

# AMX indexer: 85-95x over the torch path (27.9 vs 0.29 TFLOP/s), 100% top-2048
# set overlap on fp8 inputs. Without it the indexer alone is ~9.1 h at this Lin,
# and at chunk=32768 its [M,64,N] temp would be 1.0 TB.
USE_AMX_INDEXER=1

# EVERYTHING ON: 96 cores (was 64), chunk=32768, AMX indexer, AMX prefill+decode
# kernels, batched MoE (shared-expert ordering now fixed, gated at 512 tokens so
# decode keeps the plain loop). Lout=8 -- this run is about TTFT, TPOT is already
# measured at 4770 ms from job 27930739.

# Context sweep point. Everything on: 96 cores, AMX indexer, AMX prefill+decode
# kernels, batched MoE (gated at 512 tokens). Reports per-step INDEXER (new timer
# in kernel.py) and gather (decode-kernel accumulator) -- the two quantities that
# scale with context, measured IN-MODEL rather than standalone.

# 2026-10-19: cut 96 -> 72 cores (memory unchanged at 700G/node) so GPU jobs (8 cores,
# 160G per node) can share these nodes. Not directly comparable to 96-core sweep points.

# Collectives in bf16, not fp32 (model.py:265 casts up for no reason) -- halves
# every all_reduce. Stacks with gloo being routed over ib0 instead of 1 GbE eth0.
USE_BF16_ALLREDUCE=1

# Route gloo over ib0 (200 Gb/s) instead of eth0 (1 Gb/s). Opt-in because an
# unreachable ib0 hangs rendezvous; run_native_distributed.sh resolves the
# master ib0 address via srun and falls back to eth0 if it cannot.
USE_IB=1
