# IBENCHFP8: same InfiniteBench plumbing test as IBENCH, on the FP8 path so it
# can run NOW. IBENCH needs 2 x 628 GiB and has been PD(Resources) because the
# only ramanvr nodes with that much free have zero free CPUs.
#
# project_l is a separate partition with capacity: lh1800 (373 GiB / 72 cpu) and
# lh1801 (997 GiB / 94 cpu). FP8 weights are 314.8 GiB/rank, so 370 GiB fits.
# Running here does not compete with the queued ramanvr BF16 job.
#
# FP8 is slow -- the per-call FP32 fallback re-dequantizes weights every forward,
# which is why decode measured ~200 s/token at 16 threads. 72 threads should cut
# that. Walltime 3 h because a Slurm time limit cannot be raised after submit.
#
# This run proves the PROMPT plumbing only. Output tokens are not compared to
# anything -- no golden exists for a corpus prompt.

EXPERIMENT_ID="IBENCHFP8"
RUN_LABEL="IBENCHFP8"
RUN_MODE="generate"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="none"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="project_l"
SBATCH_ACCOUNT="kdur"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=72
SBATCH_MEM="370G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=72

LIN_TOKENS=2048
LOUT_TOKENS=16
BATCH_SIZE=1

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""
