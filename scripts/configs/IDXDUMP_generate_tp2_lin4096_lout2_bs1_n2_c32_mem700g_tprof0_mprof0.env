# IDXDUMP: capture REAL Indexer top-k indices from a prefill pass.
#
# Purpose is not performance. Sparse prefill cannot be designed without knowing
# how much adjacent query positions' top-k sets overlap -- in prefill every
# query has its OWN top-2048 (model.py:583-586), so a 16-row AMX query tile
# wants 16 different sets. Whether union-gather, mask-over-dense, or per-query
# gather wins follows directly from that overlap, and nothing in this repo
# measures it. model.py is no help: its index_mask is a dense
# [bsz, seqlen, seqlen] tensor, 1.7e10 entries at 128k.
#
# LIN MUST EXCEED 2048. topk is min(index_topk=2048, end_pos), so at Lin<=2048
# every position is selected, the mask is all-zero, and the run measures
# nothing. 4096 is the smallest power of two that is genuinely sparse (50%).
#
# Lout=2 because only the prefill pass is captured; generation is incidental.
# BF16 dequant-cache path -- the FP8 fallback took 763 s of prefill at Lin=10.

EXPERIMENT_ID="IDXDUMP"
RUN_LABEL="IDXDUMP"
RUN_MODE="generate"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32

LIN_TOKENS=4096
LOUT_TOKENS=2
BATCH_SIZE=1

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""

# early, middle, late -- index coherence very plausibly varies with depth
INDEXER_DUMP_DIR="/home/akashpt/DeepSeekRun/structured_cpu_run_clean/results_clean/results/IDXDUMP/topk"
INDEXER_DUMP_LAYERS="0,30,60"
