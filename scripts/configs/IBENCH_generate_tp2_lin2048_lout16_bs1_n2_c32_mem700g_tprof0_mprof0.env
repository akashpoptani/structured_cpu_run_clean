# IBENCH: first real run of PROMPT_SOURCE="infinitebench".
#
# Purpose is to exercise the prompt plumbing end to end -- config -> resolved env
# -> native_run -> build_synthetic_cases -> corpus.py -> a real 2048-token
# document prompt -> generation. Nothing about the output is verified against a
# golden (no reference exists for a corpus prompt); what is checked is that the
# prompt is drawn from InfiniteBench, is exactly LIN_TOKENS long, and that 16
# tokens decode without error.
#
# generate mode, Lin=2048 (>= the 1k minimum, and the same input length as the
# measured TP2K point), Lout=16. BF16 dequant-cache path: the FP8 fallback took
# 763 s of prefill at Lin=10, so it is not usable at Lin=2048.

EXPERIMENT_ID="IBENCH"
RUN_LABEL="IBENCH"
RUN_MODE="generate"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="02:00:00"

OMP_NUM_THREADS=32

LIN_TOKENS=2048
LOUT_TOKENS=16
BATCH_SIZE=1

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""
