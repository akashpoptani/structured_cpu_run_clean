# DPTHOM: HOMOGENEOUS B=2: both slots from code_debug
# dp2_true -- sequence-sharded attention (plan item 7). Rank r decodes
# batch[r::2] and holds only those sequences KV; the MoE all_gathers tokens
# so expert routing is unchanged. B=2 over 2 ranks = 1 sequence/rank.
# 700 GiB not 750: weights are ~642 GiB, and every DP run given 750 reported
# MaxRSS=750.0 exactly -- a ceiling, not a measurement. 700 leaves headroom
# while still letting RSS be a real number.
# Lout=8 for 7 decode samples rather than 1.

EXPERIMENT_ID="DPTHOM"
RUN_LABEL="DPTHOM"
RUN_MODE="generate"
REAL_RUN=1
NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0
SHARDING_MODE="dp2_true"
TP_SIZE=1
DP_SIZE=2
EP_SIZE=2
PP_SIZE=1
WEIGHTS_PRECISION="bf16"
KV_CACHE_DTYPE="bf16"
DEQUANT_FP8_WEIGHTS="none"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
BF16_CKPT_INDEX="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-bf16-dp2_epon-rank{RANK}/model.safetensors.index.json"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp1"
SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"
OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"
LIN_TOKENS=128
LOUT_TOKENS=4
BATCH_SIZE=2

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK="code_debug"
