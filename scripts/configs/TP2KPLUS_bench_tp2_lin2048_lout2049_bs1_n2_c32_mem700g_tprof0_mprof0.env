# TP2KPLUS (bench): the matched PAIR to TP2K. Identical in every field
# except LOUT_TOKENS = 2049 instead of 2048.
#
# That single token is the whole experiment. max_seq_len = LIN + LOUT, so
# TP2K builds the model at 4096 and TP2KPLUS at 4097, and DeepSeek gates two
# numerics changes on `> original_seq_len` (= 4096):
#
#   model.py:394  YaRN RoPE frequency correction  (precompute_freqs_cis)
#   model.py:535  mscale softmax_scale adjustment (MLA.__init__)
#
# At 4096 neither fires; at 4097 both do. TP2K is therefore the control and
# TP2KPLUS the treatment, differing by one config token and nothing else.
# Comparing their generated token streams isolates exactly what the
# long-context path changes. Neither has a GPU reference, so this is a
# divergence measurement, not a token-exact verification.
#
# Resources identical to TP2K so the comparison is not confounded by cores,
# memory, partition, or cache path.

EXPERIMENT_ID="TP2KPLUS"
RUN_LABEL="TP2KPLUS"
RUN_MODE="bench"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="04:00:00"

OMP_NUM_THREADS=32

LIN_TOKENS=2048
LOUT_TOKENS=2049
BATCH_SIZE=1
OMP_PROC_BIND="false"
OMP_PLACES="cores"
