# DPHOM: DP2_EPON at B=2, HOMOGENEOUS - both slots from code_debug
# Mirrors IBHET/IBHOM but on the dp2_epon path, which loads BF16 weights via
# BF16_CKPT_INDEX. So this covers two untested things at once:
#   1. batched decode under DP+EP (experts split, non-expert replicated)
#   2. batched decode on BF16 weights -- upstream linear() sends BF16 to
#      F.linear (stock torch) and only FP8 to our fp8_gemm override, so this
#      is the lower-risk kernel; FP8 at B=2 already passed in IBB2.
# 750 GiB/rank: BF16 dp2_epon shard is ~642 GiB.

EXPERIMENT_ID="DPHOM"
RUN_LABEL="DPHOM"
RUN_MODE="generate"
REAL_RUN=1
NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0
SHARDING_MODE="dp2_epon"
TP_SIZE=1
DP_SIZE=2
EP_SIZE=2
PP_SIZE=1
WEIGHTS_PRECISION="bf16"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="none"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
BF16_CKPT_INDEX="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-bf16-dp2_epon-rank{RANK}/model.safetensors.index.json"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp1"
SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="750G"
SBATCH_TIME="03:00:00"
OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"
LIN_TOKENS=128
LOUT_TOKENS=2
BATCH_SIZE=2

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK="code_debug"
