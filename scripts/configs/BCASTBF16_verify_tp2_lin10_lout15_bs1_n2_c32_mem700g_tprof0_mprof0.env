# BCASTBF16: token-exact TP2 verification with SKIP_INDEXER_BROADCAST=1,
# on the BF16 dequant-cache path. Gate for plan item 3.
#
# Why not the FP8 path: BCASTCHK (job 27840402) sat 17 min without finishing a
# 10-token prefill. DEQUANT_FP8_WEIGHTS="none" routes every Linear through the
# per-call FP32 fallback in src/overrides/kernel.py, ~10x slower than BF16.
#
# DEQUANT_CACHE_MODE="read" loads the pre-dequantized BF16 shards directly:
# no FP8 read, no dequant pass, no cache write.
#
# Sizing: BF16 weight shard = 628.4 GiB/rank; TP2K measured MaxRSS 641.7 GiB.
# 700 GiB leaves ~58 GiB over the measured peak. 600G would OOM.
# NOTE: only one node per partition had >=628 GiB free at submit time, so this
# queues until a second large node frees.

EXPERIMENT_ID="BCASTBF16"
RUN_LABEL="BCASTBF16"
RUN_MODE="verify"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"

SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"

SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="01:30:00"

OMP_NUM_THREADS=32
