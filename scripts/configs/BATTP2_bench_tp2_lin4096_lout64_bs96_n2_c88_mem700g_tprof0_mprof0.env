# BATCH SCALING to BS=96 -- the expert-saturation test.
#
# Measured at Lin=120k: BS=1 -> 2158 ms (0.463 tok/s), BS=2 -> 5470 ms
# (0.366 tok/s). Throughput FALLS with batching. Hypothesis: TPOT is MoE
# weight-streaming bound and each token routes to 8 of 256 experts, so B
# tokens touch ~8B distinct experts and streaming grows with B until every
# expert is resident. That saturates at B=32 (8*32=256), which is just past
# the BS=16 ceiling that fits at Lin=120k.
#
# This runs the sweep at SYNTH_CTX=4096 instead, because the effect is
# CONTEXT-INDEPENDENT (expert count per token does not depend on context) and
# measured TPOT barely moves with context: tiled 2042 ms @31744 vs 2158 ms
# @120000, a +116 ms span against +-200-600 ms job-to-job noise. At seq=4160
# the KV for BS=96 is 31 GB, so mem stays at 700G and leaves ~300 GB/node for
# the GPU jobs -- no memory taken from them.
#
# SYNTH_PREFILL=1024, not 4096: prefill cost is BS x SYNTH_PREFILL, and at
# BS=96 that is the difference between 98k and 393k prefilled tokens.
#
# All batch comparisons here are WITHIN one process on one node, which is the
# only way to beat the job-to-job noise that swamps cross-job comparisons.


# LOUT_TOKENS=16, not 64. TPOT measured LINEAR in batch (~2.6 s/sequence/step:
# BS=1,2,4,8 at 120k gave 2.16/2.74/2.60/2.69 s per sequence), so the BS=96
# cell costs 2.6*96 = 250 s PER STEP. At 64 steps that single cell is 4.4 h and
# the sweep would hit the 6 h limit around BS=32-48, never reaching the batch
# sizes actually asked for. 15 warm steps still gives ~2% SEM, which resolves
# the 2x effects this sweep is looking for.

EXPERIMENT_ID="BATTP2"
RUN_LABEL="BATTP2"
RUN_MODE="bench"
REAL_RUN=1

NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0

SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1

WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="all"
DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=88
SBATCH_MEM="700G"
SBATCH_TIME="06:00:00"

OMP_NUM_THREADS=88

LIN_TOKENS=4096
LOUT_TOKENS=16
BATCH_SIZE=96
BS_SWEEP="1,2,4,8,16,32,48,64,96"
SYNTH_CTX=4096
SYNTH_PREFILL=1024

PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""

PREFILL_CHUNK=1024
USE_AMX_ATTENTION=1
FLASHMLA_DECODE=1
FLASHMLA_THREADS=32
USE_BATCHED_MOE=1
FLASHMLA_MOE_MIN_TOKENS=512

# AMX indexer: 85-95x over the torch path (27.9 vs 0.29 TFLOP/s), 100% top-2048
# set overlap on fp8 inputs. Without it the indexer alone is ~9.1 h at this Lin,
# and at chunk=32768 its [M,64,N] temp would be 1.0 TB.
USE_AMX_INDEXER=1

# EVERYTHING ON: 96 cores (was 64), chunk=32768, AMX indexer, AMX prefill+decode
# kernels, batched MoE (shared-expert ordering now fixed, gated at 512 tokens so
# decode keeps the plain loop). Lout=8 -- this run is about TTFT, TPOT is already
# measured at 4770 ms from job 27930739.

# Context sweep point. Everything on: 96 cores, AMX indexer, AMX prefill+decode
# kernels, batched MoE (gated at 512 tokens). Reports per-step INDEXER (new timer
# in kernel.py) and gather (decode-kernel accumulator) -- the two quantities that
# scale with context, measured IN-MODEL rather than standalone.

# 2026-10-19: cut 96 -> 72 cores (memory unchanged at 700G/node) so GPU jobs (8 cores,
# 160G per node) can share these nodes. Not directly comparable to 96-core sweep points.

# Collectives in bf16, not fp32 (model.py:265 casts up for no reason) -- halves
# every all_reduce. Stacks with gloo being routed over ib0 instead of 1 GbE eth0.
USE_BF16_ALLREDUCE=1

# Route gloo over ib0 (200 Gb/s) instead of eth0 (1 Gb/s). Opt-in because an
# unreachable ib0 hangs rendezvous; run_native_distributed.sh resolves the
# master ib0 address via srun and falls back to eth0 if it cannot.
USE_IB=1
