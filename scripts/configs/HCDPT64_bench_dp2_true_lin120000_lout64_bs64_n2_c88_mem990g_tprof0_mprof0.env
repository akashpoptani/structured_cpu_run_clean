# HCDPT64: dp2_true (sequence-sharded attention, EP experts) at Lin=120k, BS=2 and BS=64.
# Rank r prefills/tiles/decodes only rows [r::2] (native_run SYNTH_CTX path, 2026-10-20 fix),
# holds only BS/2 sequences' KV (max_batch_size = BS/2, native_runtime.py), and loads the
# per-rank bf16 cache with only its 128 routed experts (as DPTHOM). Decode KV copy removed.
# Otherwise matched to HCNC (TP2, 27943097): same Lin/Lout, tiling, threads, kernels, chunk.
# Memory: weights ~600 GiB/rank + 32 local seqs x ~10 GiB -> ~920-960 GiB -> 990G.
# BS=64 only (BS=2 runs in parallel as HCDPT2). Whole-node memory. 27948157 (BS 2,64) cancelled at load.
EXPERIMENT_ID="HCDPT64"
RUN_LABEL="HCDPT64"
RUN_MODE="bench"
REAL_RUN=1
NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0
SHARDING_MODE="dp2_true"
TP_SIZE=1
DP_SIZE=2
EP_SIZE=2
PP_SIZE=1
WEIGHTS_PRECISION="bf16"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="none"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
BF16_CKPT_INDEX="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-bf16-dp2_epon-rank{RANK}/model.safetensors.index.json"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp1"
SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=88
SBATCH_MEM="1027177M"
SBATCH_TIME="08:00:00"
OMP_NUM_THREADS=88
LIN_TOKENS=120000
LOUT_TOKENS=64
BATCH_SIZE=64
BS_SWEEP="64"
SYNTH_CTX=120000
SYNTH_PREFILL=4096
PROMPT_SOURCE="infinitebench"
PROMPT_CORPUS_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/corpora/infinitebench"
PROMPT_SEED=0
PROMPT_TASK=""
PREFILL_CHUNK=2048
USE_AMX_ATTENTION=1
FLASHMLA_DECODE=1
FLASHMLA_THREADS=32
USE_BATCHED_MOE=1
FLASHMLA_MOE_MIN_TOKENS=512
USE_AMX_INDEXER=1
USE_BF16_ALLREDUCE=1
USE_IB=1
