# TP2BF16: TP2 inference reading the OFFLINE BF16 checkpoint directly
# (artifacts/deepseek-v3.2-bf16-tp2-rank{RANK}), instead of loading FP8 and
# either dequantizing at runtime or reading the dequant cache.
#
# Control: TP2K (same shape/threads/memory, DEQUANT_CACHE_MODE=read) measured
# TTFT=163.8s TPOT=0.973 s/tok. This should match within noise -- the weights
# are the same values by construction (both are w_fp8 * scale -> bf16); only
# the provenance and file layout differ. A mismatch means the offline and
# runtime dequant paths are NOT equivalent, which is README TODO #1.
EXPERIMENT_ID="TP2BF16"
RUN_LABEL="TP2BF16"
RUN_MODE="bench"
REAL_RUN=1
NATIVE_NO_LOAD_WEIGHTS=0
NATIVE_NO_GENERATE=0
SHARDING_MODE="tp2"
TP_SIZE=2
DP_SIZE=1
EP_SIZE=1
PP_SIZE=1
WEIGHTS_PRECISION="fp8"
KV_CACHE_DTYPE="fp8"
DEQUANT_FP8_WEIGHTS="none"
DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
BF16_CKPT_INDEX="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-bf16-tp2-rank{RANK}/model.safetensors.index.json"
SHARDED_CKPT_PATH="/scratch/ramanvr_root/ramanvr/akashpt/DeepSeekRun_runtime/artifacts/deepseek-v3.2-mp2-rerun"
SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="04:00:00"
OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"
LIN_TOKENS=2048
LOUT_TOKENS=2048
BATCH_SIZE=1
