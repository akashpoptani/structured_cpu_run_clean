# DPTRUE: first dp2_true session -- a CORRECTNESS check, not a timing run.
# Same het/hom pair as DPB2 but with sequence-sharded attention.
#
# No warmup child and Lout=4: 96% of a dp2 run is weight load (944 s of DPMEM's
# 979 s), so trimming children or Lout saves seconds out of ~16 min. The floor
# is the 580 GiB BF16 per-rank shard; there is no smaller DP artifact (mp1 is
# 748 GiB) and --no-load-weights exits before the overrides install, so it
# cannot exercise this code.
#
# All children share BATCH_SIZE=2 -- required, because the MoE forward is bound
# ONCE before any child runs, so a session mixing B=1 and B>1 would bind for one
# and run the other. native_session.py rejects that explicitly.
SESSION_TAG="DPTRUE"
SESSION_CHILDREN="DPTHET DPTHOM"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"

DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
