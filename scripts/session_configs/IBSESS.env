# IBSESS: minimal two-child session to exercise native_session.py with
# PROMPT_SOURCE=infinitebench. The two children differ only in PROMPT_TASK and
# Lin, so a pass shows the session loop re-builds a DIFFERENT corpus prompt per
# child rather than reusing the first one.
SESSION_TAG="IBSESS"
SESSION_CHILDREN="IBSESSA IBSESSB"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=16
SBATCH_MEM="370G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=16
OMP_PROC_BIND="false"
OMP_PLACES="cores"

DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
