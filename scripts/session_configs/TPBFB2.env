# TPBFB2: TP2 + BF16 (dequant cache) at B=2. Same het/hom pair as IBB2 and DPB2,
# completing the precision x sharding matrix for batched decode.
SESSION_TAG="TPBFB2"
SESSION_CHILDREN="TPBFHET TPBFHOM"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"

DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"
