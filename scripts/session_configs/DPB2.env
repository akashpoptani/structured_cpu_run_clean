# DPB2: DP2_EPON batched pair, same design as IBB2 but on the DP+EP path with
# BF16 weights. One weight load, two children differing only in batch composition.
SESSION_TAG="DPB2"
SESSION_CHILDREN="DPHET DPHOM"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="750G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"

DEQUANT_CACHE_MODE="off"
DEQUANT_CACHE_PATH=""
