# TPBFSCALE: TP2 BF16 decode scaling, B=1 vs B=2 at Lin=128, identical cores and
# precision in one session. Fills the missing B=1 cell and makes the B=1 -> B=2
# comparison valid (the earlier B=1 point was FP8 at 16 cores).
# TPBFW runs first and is discarded -- within-session child 1 pays warmup.
SESSION_TAG="TPBFSCALE"
SESSION_CHILDREN="TPBFW TPBF1 TPBF2"

SBATCH_PARTITION="ramanvr"
SBATCH_ACCOUNT="ramanvr"
SBATCH_NODES=2
SBATCH_TASKS_PER_NODE=1
SBATCH_CPUS_PER_TASK=32
SBATCH_MEM="700G"
SBATCH_TIME="03:00:00"

OMP_NUM_THREADS=32
OMP_PROC_BIND="false"
OMP_PLACES="cores"

DEQUANT_CACHE_MODE="read"
DEQUANT_CACHE_PATH="/scratch/ramanvr_root/ramanvr/akashpt/models/deepseek-v3.2-tp2-bf16-dequant-all"
